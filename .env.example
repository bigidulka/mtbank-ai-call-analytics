# Copy to .env. Replace every blank value with a unique secret before starting Compose.
# Do not commit .env. Model weights are provisioned separately and ignored by Git.
OPENWEBUI_PORT=3000
WEBUI_ADMIN_EMAIL=admin@example.test
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=MTBank Attachment Probe Admin
WEBUI_SECRET_KEY=
PIPELINES_API_KEY=
MTBANK_ATTACHMENT_SIGNING_KEY=
MTBANK_API_KEY=
GRAFANA_ADMIN_PASSWORD=

POSTGRES_DB=mtbank_ai
POSTGRES_USER=mtbank_ai
POSTGRES_PASSWORD=

MTBANK_ENVIRONMENT=production
MTBANK_WORKFLOW__CODE_SHA=replace-with-git-rev-parse-HEAD
MTBANK_AGENT_RUNTIME__GATEWAY__BASE_URL=https://api.example.invalid/v1
MTBANK_AGENT_RUNTIME__GATEWAY__API_KEY=
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__DEFAULT_MODEL=replace-with-openai-compatible-model-id
# Optional per-agent overrides. Leave blank to use DEFAULT_MODEL.
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__CLASSIFIER_MODEL=
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__QUALITY_MODEL=
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__COMPLIANCE_MODEL=
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__SUMMARIZER_MODEL=
