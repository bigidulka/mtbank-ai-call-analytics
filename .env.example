# Copy to .env. Replace every blank value with a unique secret before starting Compose.
# Do not commit .env. Model weights are provisioned separately and ignored by Git.
OPENWEBUI_PORT=3000
WEBUI_ADMIN_EMAIL=admin@example.test
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=MTBank Attachment Probe Admin
WEBUI_SECRET_KEY=
PIPELINES_API_KEY=
MTBANK_ATTACHMENT_SIGNING_KEY=
MTBANK_API_KEY=
GRAFANA_ADMIN_PASSWORD=

POSTGRES_DB=mtbank_ai
POSTGRES_USER=mtbank_ai
POSTGRES_PASSWORD=

MTBANK_ENVIRONMENT=production
MTBANK_WORKFLOW__CODE_SHA=replace-with-git-rev-parse-HEAD
MTBANK_AGENT_RUNTIME__GATEWAY__BASE_URL=https://api.example.invalid/v1
MTBANK_AGENT_RUNTIME__GATEWAY__API_KEY=
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__DEFAULT_MODEL=replace-with-openai-compatible-model-id
# Optional per-agent overrides. Leave blank to use DEFAULT_MODEL.
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__CLASSIFIER_MODEL=
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__QUALITY_MODEL=
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__COMPLIANCE_MODEL=
MTBANK_AGENT_RUNTIME__GATEWAY__MODELS__SUMMARIZER_MODEL=

# Experimental no-GPU speech profile only; required when using docker-compose.custom-speech.yml.
OPENAI_TRANSCRIPTION_API_KEY=
OPENAI_TRANSCRIPTION_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
MTBANK_CUSTOM_SPEECH__ROLE_MODEL=gpt-5.6-sol
# Semantic role reconstruction is on the critical path of transcription, so it may need a
# gateway with headroom the analysis agents do not. Blank falls back to the application
# gateway (MTBANK_AGENT_RUNTIME__GATEWAY__*).
MTBANK_CUSTOM_SPEECH_ROLE_BASE_URL=
MTBANK_CUSTOM_SPEECH_ROLE_API_KEY=

# Even more experimental: unofficial ChatGPT Web bridge instead of the official OpenAI API.
# Only used with docker-compose.chatgpt-bridge.yml. Leave blank until the bridge is paired;
# see docs/speech-backend-switch.md. Never fill this from a chat session or command output.
CHATGPT_BRIDGE_API_TOKEN=
# chatgpt.com answers 403 to every request from most datacenter IP ranges, so a host
# without a VPN needs an egress proxy here (http://, https://, socks5://). Blank means
# direct egress. Sibling services are exempt via NO_PROXY and stay on the Docker network.
CHATGPT_BRIDGE_EGRESS_PROXY=
