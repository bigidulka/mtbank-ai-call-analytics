#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE=(-f docker-compose.yml)
RUNPOD=(-f docker-compose.yml -f docker-compose.runpod.yml)
CUSTOM=(-f docker-compose.yml -f docker-compose.custom-speech.yml)
BRIDGE=(-f docker-compose.yml -f docker-compose.custom-speech.yml -f docker-compose.chatgpt-bridge.yml)
BACKEND="${1:-status}"

cd "$ROOT"

current_backend() {
  local base_url
  base_url="$(docker inspect mtbank-ai-call-analytics-api-1 --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
    | awk -F= '$1=="MTBANK_SPEECH__BASE_URL"{print $2}')"
  case "$base_url" in
    http://custom-speech:8010) echo custom ;;
    https://*) echo runpod ;;
    http://speech:8010) echo local_cpu ;;
    *) echo unknown ;;
  esac
}

require_ready() {
  docker compose "${BASE[@]}" exec -T api python - <<'PY'
from urllib.request import urlopen
urlopen("http://127.0.0.1:8000/health/ready", timeout=5).read()
PY
}

case "$BACKEND" in
  status)
    printf 'speech_backend=%s\n' "$(current_backend)"
    docker compose "${BASE[@]}" ps api --format 'api={{.State}}/{{.Health}}'
    ;;
  custom)
    docker compose "${CUSTOM[@]}" config --quiet
    custom_image="$(docker compose "${CUSTOM[@]}" config --images | grep -E '(^|/)mtbank-ai-custom-speech:' | head -1)"
    if [[ "$custom_image" == ghcr.io/* ]]; then
      docker compose "${CUSTOM[@]}" pull custom-speech
    else
      docker compose "${CUSTOM[@]}" build custom-speech
    fi
    docker compose "${CUSTOM[@]}" up -d --wait custom-speech api
    [[ "$(current_backend)" == custom ]] || { echo 'custom switch verification failed' >&2; exit 1; }
    require_ready
    printf 'speech_backend=custom\n'
    ;;
  runpod)
    docker compose "${RUNPOD[@]}" config --quiet
    docker compose "${RUNPOD[@]}" up -d --wait api
    [[ "$(current_backend)" == runpod ]] || { echo 'RunPod switch verification failed' >&2; exit 1; }
    require_ready
    custom_container="$(docker compose "${CUSTOM[@]}" ps -q custom-speech)"
    if [[ -n "$custom_container" ]]; then
      docker compose "${CUSTOM[@]}" stop custom-speech >/dev/null
    fi
    bridge_container="$(docker compose "${BRIDGE[@]}" ps -q chatgpt-bridge)"
    if [[ -n "$bridge_container" ]]; then
      docker compose "${BRIDGE[@]}" stop chatgpt-bridge >/dev/null
    fi
    printf 'speech_backend=runpod\n'
    ;;
  bridge-up)
    # Starts only the chatgpt-bridge daemon so it can be paired before custom-speech depends on it.
    docker compose "${BRIDGE[@]}" config --quiet
    docker compose "${BRIDGE[@]}" build chatgpt-bridge
    docker compose "${BRIDGE[@]}" up -d --wait chatgpt-bridge
    printf 'chatgpt-bridge started; see docs/speech-backend-switch.md for the pairing runbook\n'
    ;;
  bridge-pair)
    # Must be run from the operator's own machine, tunnelled to this host, never scripted end-to-end:
    # ssh -L 37182:127.0.0.1:37182 <this-host>
    # then, on this host in a second session, issue the one-time code:
    docker compose "${BRIDGE[@]}" exec -T chatgpt-bridge chatgpt-transcribe-connect pair
    ;;
  bridge-status)
    docker compose "${BRIDGE[@]}" exec -T chatgpt-bridge chatgpt-transcribe-connect status
    ;;
  bridge-token-path)
    # Prints only the path; never reads or echoes the token value itself.
    docker compose "${BRIDGE[@]}" exec -T chatgpt-bridge chatgpt-transcribe-connect api-token-path
    ;;
  custom-bridge)
    docker compose "${BRIDGE[@]}" config --quiet
    bridge_image="$(docker compose "${BRIDGE[@]}" config --images | grep -E '(^|/)mtbank-ai-chatgpt-bridge:' | head -1)"
    if [[ "$bridge_image" == ghcr.io/* ]]; then
      docker compose "${BRIDGE[@]}" pull chatgpt-bridge
    else
      docker compose "${BRIDGE[@]}" build chatgpt-bridge
    fi
    custom_image="$(docker compose "${BRIDGE[@]}" config --images | grep -E '(^|/)mtbank-ai-custom-speech:' | head -1)"
    if [[ "$custom_image" == ghcr.io/* ]]; then
      docker compose "${BRIDGE[@]}" pull custom-speech
    else
      docker compose "${BRIDGE[@]}" build custom-speech
    fi
    docker compose "${BRIDGE[@]}" up -d --wait chatgpt-bridge custom-speech api
    [[ "$(current_backend)" == custom ]] || { echo 'custom-bridge switch verification failed' >&2; exit 1; }
    require_ready
    printf 'speech_backend=custom (chatgpt-bridge ASR)\n'
    ;;
  *)
    echo 'usage: deploy/speech-backend {status|custom|custom-bridge|runpod|bridge-up|bridge-pair|bridge-status|bridge-token-path}' >&2
    exit 2
    ;;
esac
